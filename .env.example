# =====================================================================
# Variables de entorno para docker compose
# Copia este archivo a `.env` y ajusta los valores antes de levantar.
#   cp .env.example .env
# =====================================================================

# --- Base de datos (MariaDB) ---
# Contraseña del usuario root de MariaDB (uso administrativo interno).
MARIADB_ROOT_PASSWORD=cambia_este_root_password
# Nombre de la base de datos que usará la aplicación.
DB_NAME=moderacionbd
# Usuario y contraseña que usará la API para conectarse a la BD.
DB_USER=moderacion
DB_PASSWORD=cambia_este_password
# Puerto host expuesto para MariaDB (cámbialo si el 3306 está ocupado).
DB_HOST_PORT=3306
# Tamaño del pool de conexiones (mínimo 1) y timeout de conexión (seg).
DB_POOL_SIZE=5
DB_CONNECTION_TIMEOUT=10

# --- API (FastAPI) ---
# Entorno de ejecución: production | development.
ENV=production
# Habilita la documentación interactiva (/docs, /redoc). Recomendado false en prod.
DOCS_ENABLED=false
# Orígenes permitidos para CORS (coma-separados). Debe incluir el origen del frontend.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Configuración de cookies.
COOKIES_SECURE=false
COOKIES_SAMESITE=lax
# Puerto host expuesto para la API.
API_HOST_PORT=8000

# --- Moderación con IA (DeepSeek) ---
# REQUERIDO para moderación real con IA. Si se deja vacío, se usa el fallback local.
# Obtén tu clave en https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# --- Frontend (Nginx) ---
# Puerto host donde se sirve la aplicación web.
FRONTEND_HOST_PORT=8080
