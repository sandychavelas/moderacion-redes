# =====================================================================
# VARIABLES DE ENTORNO PARA EL SERVICIO: moderacion-redes-frontend (PWA)
# =====================================================================

# 1. URL PÚBLICA DEL BACKEND (FastAPI en Railway):
# Es la URL generada en la pestaña "Settings" -> "Networking" del servicio de la API.
# Debe tener el protocolo HTTPS y no llevar barra diagonal al final.
# Ejemplo: https://moderacion-redes-api-production-xxxx.up.railway.app
VITE_API_URL=https://tu-api.up.railway.app

# 2. REFERENCIA DINÁMICA DE RAILWAY (OPCIÓN ALTERNATIVA RECOMENDADA):
# En lugar de escribir la URL fija, en Railway puedes usar una referencia:
# VITE_API_URL=https://${{moderacion-redes-api.RAILWAY_PUBLIC_DOMAIN}}
# O si Railway genera UPSTREAM_URL:
# VITE_API_URL=${{moderacion-redes-api.RAILWAY_PUBLIC_DOMAIN}}

# 3. PUERTO LOCAL (Solo para desarrollo local con Vite dev server):
PORT=5173
