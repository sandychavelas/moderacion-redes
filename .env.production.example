# =====================================================================
# PLANTILLA DE VARIABLES DE ENTORNO PARA DESPLIEGUE EN PRODUCCIÓN (RAILWAY)
# =====================================================================
# Configura estas variables en tu proyecto de Railway en cada servicio respectivo.

# =====================================================================
# 1. SERVICIO: DATABASE (MariaDB / MySQL en Railway)
# =====================================================================
# Railway genera automáticamente estas variables al crear el servicio de base de datos:
# MYSQLHOST=mariadb.railway.internal
# MYSQLPORT=3306
# MYSQLUSER=root
# MYSQLPASSWORD=genera_una_clave_segura
# MYSQLDATABASE=railway (o moderacionbd)

# Si prefieres usar nombres tradicionales, puedes definir:
DB_HOST=mariadb.railway.internal
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_seguro
DB_NAME=moderacionbd
DB_POOL_SIZE=5
DB_CONNECTION_TIMEOUT=10

# =====================================================================
# 2. SERVICIO: API (FastAPI / Python)
# =====================================================================
# Entorno de ejecución
ENV=production

# Habilitar documentación Swagger (/docs) en producción (true / false)
DOCS_ENABLED=true

# Orígenes CORS permitidos (añade la URL de tu frontend de Railway sobre HTTPS)
# Ejemplo: https://moderacion-frontend-production.up.railway.app
CORS_ORIGINS=https://tu-frontend.up.railway.app

# URL directa del frontend (también leída automáticamente por la API)
FRONTEND_URL=https://tu-frontend.up.railway.app

# Cookies seguras (true en producción HTTPS)
COOKIES_SECURE=true
COOKIES_SAMESITE=lax

# Puerto dinámico: Railway inyecta $PORT automáticamente.
# Por defecto uvicorn se ejecutará en 0.0.0.0:${PORT:-8000}
PORT=8000

# Clave de API de DeepSeek para Moderación con Inteligencia Artificial (Opcional)
# Si se deja vacía, el sistema usa el motor de inferencia local/fallback
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# =====================================================================
# 3. SERVICIO: FRONTEND (React + Vite + Nginx PWA)
# =====================================================================
# URL pública de tu API desplegada en Railway (con protocolo HTTPS)
# IMPORTANTE: Se inyecta como Build Arg o variable de entorno para que Vite
# compile las peticiones hacia tu backend FastAPI.
# Ejemplo: https://moderacion-api-production.up.railway.app
VITE_API_URL=https://tu-api.up.railway.app

# Puerto: Nginx en Railway escucha dinámicamente en el puerto asignado ($PORT) o 80.
PORT=80
