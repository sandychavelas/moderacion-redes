# =====================================================================
# VARIABLES DE ENTORNO PARA EL SERVICIO: moderacion-redes-api (FastAPI)
# =====================================================================

# ---------------------------------------------------------------------
# CASO 1: DESPLIEGUE EN RAILWAY USANDO REFERENCIAS DEL SERVICIO MySQL
# (Recomendado: Puedes copiar y pegar esto directamente en "Raw Editor"
#  en la pestaña "Variables" del servicio `moderacion-redes-api` en Railway)
# ---------------------------------------------------------------------
ENV=production
DOCS_ENABLED=true

# Referencias directas al servicio MySQL en Railway:
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_USER=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
DB_NAME=${{MySQL.MYSQLDATABASE}}
DB_POOL_SIZE=5
DB_CONNECTION_TIMEOUT=10

# Orígenes CORS permitidos (Coloca la URL generada de tu frontend en Railway):
# Ejemplo: https://moderacion-redes-frontend-production.up.railway.app
# También puedes usar la referencia de Railway: https://${{moderacion-redes-frontend.RAILWAY_PUBLIC_DOMAIN}}
CORS_ORIGINS=https://${{moderacion-redes-frontend.RAILWAY_PUBLIC_DOMAIN}}
FRONTEND_URL=https://${{moderacion-redes-frontend.RAILWAY_PUBLIC_DOMAIN}}

COOKIES_SECURE=true
COOKIES_SAMESITE=lax

# Clave de DeepSeek para Inteligencia Artificial (Opcional, si está vacía usa el simulador local)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1


# ---------------------------------------------------------------------
# CASO 2: DESPLIEGUE EN RAILWAY CON VARIABLES NATIVAS DE MYSQL
# (Si importas directamente las variables nativas con "+ Add Reference")
# Nuestra API detecta automáticamente estas variables sin tener que renombrarlas:
# ---------------------------------------------------------------------
# MYSQLHOST=${{MySQL.MYSQLHOST}}
# MYSQLPORT=${{MySQL.MYSQLPORT}}
# MYSQLUSER=${{MySQL.MYSQLUSER}}
# MYSQLPASSWORD=${{MySQL.MYSQLPASSWORD}}
# MYSQLDATABASE=${{MySQL.MYSQLDATABASE}}


# ---------------------------------------------------------------------
# CASO 3: DESARROLLO LOCAL O DOCKER COMPOSE LOCAL
# (Para tu archivo .env local en tu computadora)
# ---------------------------------------------------------------------
# ENV=development
# DOCS_ENABLED=true
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=tu_password_local
# DB_NAME=moderacionbd
# DB_POOL_SIZE=5
# DB_CONNECTION_TIMEOUT=10
# CORS_ORIGINS=http://localhost:5173,http://localhost:8080